# Managed by Ansible (roles/hardening) - do not edit by hand.
#
# This host never routes traffic for anyone else (net.ipv4.ip_forward and
# net.ipv6.conf.all.forwarding are already 0), so it has no business
# sending ICMP redirects, and reverse-path filtering can be strict rather
# than loose since there's no asymmetric routing to accommodate.

net.ipv4.conf.all.rp_filter = 1
net.ipv4.conf.default.rp_filter = 1

net.ipv4.conf.all.send_redirects = 0
net.ipv4.conf.default.send_redirects = 0

net.ipv4.conf.all.log_martians = 1
net.ipv4.conf.default.log_martians = 1
