# Managed by Ansible (roles/hardening) - do not edit by hand.
#
# elodin logs every query (log.queries: true in roles/elodin) to stdout,
# which lands here. Nothing else in this repo bounds the journal, so
# without this it inherits whatever the distro default happens to be - not
# a number this box's 1 GB of RAM and disk should be left to find out the
# hard way during a query flood.
[Journal]

# Storage=auto only becomes disk-backed once /var/log/journal exists; until
# then a flood fills the volatile journal, which lives in tmpfs - RAM, not
# disk, on a box that only has 1 GB of it. Persistent avoids trading one
# resource exhaustion for a worse one.
Storage=persistent

# Two independent caps, so a burst that's small but sustained (bounded by
# size) and one that's brief but huge (bounded by time) both get vacuumed.
SystemMaxUse=500M
MaxRetentionSec=14day

# Rotate into a fresh file at least daily, so vacuuming reclaims space in
# day-sized steps instead of having to wait for one giant file to age out.
MaxFileSec=1day

# The early-boot/fallback volatile journal (before Storage=persistent's
# directory is reachable). Kept small on principle: this ring buffer lives
# in RAM.
RuntimeMaxUse=64M
