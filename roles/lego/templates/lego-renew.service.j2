[Unit]
Description=Renew the Lego-issued certificate for {{ elodin_domain }}
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=1h
StartLimitBurst=3

[Service]
Type=oneshot
User={{ lego_user }}
Group={{ lego_group }}

AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths={{ lego_home }}

# "+" runs these two as root regardless of the User= above - opening and
# closing the firewall hole needs it, and a "+" prefixed Exec*= is the
# supported way to pair a privileged step with an otherwise unprivileged
# unit. ExecStopPost always runs, even if lego fails or the HTTP-01
# challenge times out, so :80 never stays open past this unit.
ExecStartPre=+/usr/local/sbin/elodin-acme-fw.sh open
ExecStopPost=+/usr/local/sbin/elodin-acme-fw.sh close

ExecStart={{ lego_bin_dir }}/lego run --accept-tos --email {{ elodin_acme_email }} --domains {{ elodin_domain }} --path {{ lego_home }} --http --http.address :80 --renew-days {{ lego_renew_days }} --deploy-hook /usr/local/sbin/elodin-cert-hook.sh
