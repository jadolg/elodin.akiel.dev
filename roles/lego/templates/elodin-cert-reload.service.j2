[Unit]
Description=Reload elodin after Lego renews its DoT certificate
# SIGHUP (which "systemctl reload" sends per elodin.service's ExecReload)
# re-reads the DoT/DoH certificate and key files in place, with no restart
# and no dropped connections.

[Service]
Type=oneshot
ExecStart=/usr/bin/systemctl reload elodin.service
