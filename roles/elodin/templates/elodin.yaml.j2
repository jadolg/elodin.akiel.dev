# Managed by Ansible (roles/elodin) - do not edit by hand.

log:
  level: {{ elodin_log_level }}
  queries: {{ 'true' if elodin_log_queries else 'false' }}
  file: ""

server:
  workers: 0
  upstream_workers: 0
  # The table, and one client's share of it. 1,024 threads and descriptors,
  # inside the packaged unit's LimitNOFILE=8192 and sized for this box's 1 GB
  # rather than for examples/public.yaml's 2,048.
  #
  # The share is the figure that matters here. At the old 512/50 a stranger
  # filled the whole table out of 11 prefixes, and an IPv6 /48 - a routine
  # allocation - is 65,536 of them; at 1,024/24 the same attack costs 43. That
  # is cost rather than impossibility, which is why the firewall now carries a
  # per-source connection limit of its own (roles/firewall). 24 is what
  # examples/public.yaml recommends: a real client holds one connection per
  # device and reuses it, so this is ample for anybody legitimate.
  max_connections: 1024
  client_timeout: 10s
  max_pending: 0

  # DynamicUser in the systemd unit already drops root once the listeners
  # are bound; there is nothing to name here.
  user: ""
  group: ""

  allow_from: []

  # Public resolver: bound per source prefix so one stranger holding idle
  # TCP/DoT/DoH connections can't fill the whole connection table.
  max_connections_per_prefix: 24

  max_udp_response: 1232

  rate_limit:
    enabled: true
    responses_per_second: 500
    slip: 2

listeners:
  # Plain DNS, for this host alone: the package's systemd-resolved takeover
  # writes "nameserver 127.0.0.1" into /etc/resolv.conf, and that is the only
  # client these two have. They bound "::" before, which made roles/firewall
  # the single thing standing between server.allow_from's empty list and an
  # open resolver on :53 - one ruleset that fails to load at boot, one ufw
  # re-enabled by a package, and this box amplifies for whoever finds it,
  # within hours. Binding loopback means a firewall that lapses exposes
  # nothing here. The firewall still drops 53 from everywhere: two
  # independent reasons this port is not public, neither relying on the other.
  udp:
    enabled: true
    address: "127.0.0.1"
    port: 53
  tcp:
    enabled: true
    address: "127.0.0.1"
    port: 53
  dot:
    enabled: true
    address: "::"
    port: 853
    cert_file: {{ elodin_cert_dir }}/{{ elodin_domain }}.crt
    key_file: {{ elodin_cert_dir }}/{{ elodin_domain }}.key
  doh:
    enabled: {{ 'true' if elodin_doh_enabled else 'false' }}
    address: "::"
    port: 443
    path: /dns-query
    cert_file: {{ elodin_cert_dir }}/{{ elodin_domain }}.crt
    key_file: {{ elodin_cert_dir }}/{{ elodin_domain }}.key

metrics:
  enabled: {{ 'true' if elodin_metrics_enabled else 'false' }}
  address: "{{ elodin_metrics_address }}"
  port: {{ elodin_metrics_port }}
  path: {{ elodin_metrics_path }}

upstream:
  strategy: failover
  timeout: 5s
  attempts: 2
  # 16, down from 32, because 32 was buying handshakes at the price of
  # failures. Every idle connection held is an open connection at the far end,
  # and Quad9 refuses a source that holds too many - measured from one host,
  # refusals begin somewhere around 13 to 25 concurrent. The refusal arrives
  # after the TLS handshake rather than at it: elodin connects, handshakes,
  # sends the query, and the far side hangs up, which is the io_error that was
  # elodin_upstream_failure_kind_total's only series for quad9-dot while this
  # sat at 32. Cloudflare never once refused under the same setting.
  #
  # Raising this to avoid a handshake is still the right instinct, and 8 was
  # too few for a cache-miss rate like this one's. 16 is the compromise being
  # tested; watch the failure-by-kind panel before moving it either way.
  max_idle: 16
  idle_timeout: 30s
  bootstrap: {{ elodin_upstream_bootstrap | to_json }}
  servers:
{% for s in elodin_upstream_servers %}
    - name: {{ s.name }}
      type: {{ s.type }}
      address: {{ s.address }}
      port: {{ s.port }}
      hostname: {{ s.hostname }}
{% endfor %}

cache:
  enabled: true
  # Sized for a public resolver's tail - many strangers asking many different
  # names - within this box's 1 GB. At the measured ~463 bytes an entry,
  # 200,000 answers is about 90 MB, which is what max_bytes is set beside;
  # the blocklists below are the other ~100 MB at ~129 bytes a rule.
  #
  # The old 10,000 was the term a random-subdomain flood attacked: a few
  # seconds of made-up names under a real domain evicted everything worth
  # keeping, and every real query behind it became an upstream query. Breadth
  # is what keeps the hit rate up and the flood off the upstreams.
  max_entries: 200000
  max_bytes: 96MiB
  min_ttl: 0
  max_ttl: 24h
  negative_ttl: 300
  # On (RFC 8767): an upstream that goes away must not take every client's
  # resolution with it. An expired entry is served only after the refresh has
  # failed, with a short TTL so the client comes back.
  serve_stale: true

blocking:
  enabled: {{ 'true' if elodin_blocking_enabled else 'false' }}
  response: nxdomain
  custom_ipv4: 0.0.0.0
  custom_ipv6: "::"
  block_ttl: 60
  refresh: 24h
  cache_dir: /var/cache/elodin
  lists:
{% for l in elodin_blocklists %}
    - name: {{ l.name }}
      url: {{ l.url }}
      format: {{ l.format }}
{% endfor %}
  allowlists: []
  rules: []
  # Names that outrank every blocklist, whatever the lists say (the @@ prefix is
  # implied). Driven by elodin_allow in group_vars.
  allow: {{ elodin_allow | to_json }}

dnssec:
  enabled: {{ 'true' if elodin_dnssec_enabled else 'false' }}
  max_nsec3_iterations: 100

cookies:
  enabled: true
  require: false
  upstream: true

# Off by default upstream; a public resolver has every reason to refuse an
# upstream answer that points a public name into private address space
# (rebinding attacks) and to be authoritative for reserved names that only
# make sense on someone else's private network.
rebind:
  enabled: true
  allow_domains:
    - akiel.dev
  allow_loopback: false

special_use:
  enabled: true
  onion: true
  local: true
  test: true
  home_arpa: true

rewrites: []
