// Managed by Ansible (roles/alloy) - do not edit by hand.

loki.write "default" {
	endpoint {
		url = "{{ alloy_loki_url }}"
	}
	external_labels = { {% for k, v in alloy_external_labels.items() %}{{ k }} = "{{ v }}"{% if not loop.last %}, {% endif %}{% endfor %} }
}

{% if elodin_metrics_enabled %}
prometheus.remote_write "default" {
	endpoint {
		url = "{{ alloy_prometheus_url }}"
	}
	external_labels = { {% for k, v in alloy_external_labels.items() %}{{ k }} = "{{ v }}"{% if not loop.last %}, {% endif %}{% endfor %} }
}

// elodin binds this on loopback, so the scrape never leaves the host.
prometheus.scrape "elodin" {
	targets = [{
		__address__ = "{{ elodin_metrics_address }}:{{ elodin_metrics_port }}",
		job         = "elodin",
		instance    = "{{ inventory_hostname }}",
	}]
	metrics_path    = "{{ elodin_metrics_path }}"
	scrape_interval = "{{ alloy_scrape_interval }}"
	forward_to      = [prometheus.remote_write.default.receiver]
}

{% endif %}
loki.relabel "journal" {
	forward_to = []

	rule {
		source_labels = ["__journal__systemd_unit"]
		target_label  = "unit"
	}
}

loki.source.journal "systemd" {
	max_age       = "12h"
	relabel_rules = loki.relabel.journal.rules
	forward_to    = [loki.write.default.receiver]
	labels        = { host = "{{ inventory_hostname }}" }
}
